# ==============================================================================
# Intent — AI Shopping Firewall Environment Configuration
# ==============================================================================
# IMPORTANT FOR PRODUCTION DEPLOYMENTS:
# 1. Persistent Storage: A persistent disk mount (e.g. /var/data) or PostgreSQL
#    is REQUIRED. Ephemeral containers wipe signed mandates and the SHA-256
#    audit chain on restart, rendering all historical verifications invalid.
# 2. Single-Worker Concurrency: With SQLite, set WEB_CONCURRENCY=1. In-memory
#    reservation mutexes and sequential hash-chaining require single-worker
#    serialization to prevent double-spending and ledger forks.
# 3. Production Key Refusal: If APP_ENV=production, the server will abort startup
#    if MANDATE_SIGNING_KEY, ADMIN_API_KEY, CSRF_SECRET, or SESSION_SECRET are
#    missing or left at insecure development defaults.
# ==============================================================================

# === Application Environment & Mode ===
# "production" | "development" | "test"
APP_ENV=development

# "demo" (per-visitor sandboxes) | "admin" (requires admin key in header)
APP_MODE=demo

# === Database Persistence & Concurrency ===
# Path to SQLite database or PostgreSQL connection URL.
# Production recommendation: mount a persistent volume at /var/data
DATABASE_PATH=intent.db
# DATABASE_URL=sqlite:////var/data/intent.db

# Concurrency worker count (MUST be 1 with SQLite)
WEB_CONCURRENCY=1

# === Cryptographic Security Keys ===
# Ed25519 signing key for spending mandates (64-character hex string representing 32 bytes).
# Generate: python3 -c 'import secrets; print(secrets.token_hex(32))'
# In dev, an ephemeral key is auto-generated if left blank.
MANDATE_SIGNING_KEY=

# Admin API Key for administrative endpoints (POST /api/mandates, DELETE /api/mandates/*, etc.)
# Generate: openssl rand -hex 32
ADMIN_API_KEY=admin_super_secret_test_key

# Secret key for stateless HMAC-SHA256 CSRF tokens on approval confirmation pages.
# Generate: openssl rand -hex 32
CSRF_SECRET=dev_csrf_secret_change_me_in_production

# Secret key for signing per-visitor demo sandbox session cookies.
# Generate: openssl rand -hex 32
SESSION_SECRET=dev_session_secret_change_me_in_production

# Demo session TTL in hours and max requests per session per hour
SESSION_TTL_HOURS=2
SESSION_RATE_LIMIT_PER_HOUR=30

# === Channel3 API ===
CHANNEL3_API_KEY=your_channel3_api_key_here

# === PayPal Sandbox Credentials ===
PAYPAL_CLIENT_ID=your_paypal_sandbox_client_id_here
PAYPAL_CLIENT_SECRET=your_paypal_sandbox_client_secret_here
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
# Webhook ID registered in PayPal Developer Sandbox Dashboard (Apps & Credentials > Webhooks)
PAYPAL_WEBHOOK_ID=

# === LLM Provider (stub | openai | gemini | anthropic) ===
LLM_PROVIDER=stub
# OPENAI_API_KEY=your_openai_key_here
# GOOGLE_AI_API_KEY=your_gemini_key_here
# ANTHROPIC_API_KEY=your_anthropic_key_here

# === Rate Limits & Quotas ===
RATE_LIMIT_PER_15MIN=5
RATE_LIMIT_PER_DAY=30
GLOBAL_CHANNEL3_DAILY_CAP=250
GLOBAL_LLM_DAILY_CAP=400
CHANNEL3_CACHE_TTL_SECONDS=3600

# === Execution-time Price Drift Tolerance ===
PRICE_DRIFT_TOLERANCE=0.01

# === Approval Flow & Notifications ===
APPROVAL_TOKEN_TTL_MINUTES=15
NOTIFIER_TYPE=console
# TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ
# TELEGRAM_CHAT_ID=123456789
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=supervisor@example.com
# SMTP_PASSWORD=app_password_here
# NOTIFICATION_EMAIL=supervisor@example.com
